<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <!-- Direct Connect (DC++) in-progress download; often a playable video mid-transfer. -->
  <mime-type type="application/x-dcpp-incomplete">
    <comment>Direct Connect in-progress download</comment>
    <glob pattern="*.dctmp"/>
  </mime-type>
</mime-info>
